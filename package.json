{
  "name": "ai-video-workbench",
  "version": "0.1.0",
  "description": "AI 视频工作台 Windows 桌面端",
  "main": "desktop/main.js",
  "private": true,
  "author": "warmseadog",
  "license": "UNLICENSED",
  "scripts": {
    "start": "node mvp/server.js",
    "desktop:dev": "electron .",
    "verify": "node --check mvp/app.js && node --check mvp/core.js && node --check mvp/server.js && node --check desktop/main.js && node --check desktop/preload.js && node --check desktop/runtime.js && node --check desktop/verify-runtime.js && node --check desktop/verify-package.js && node mvp/verify-core.js && node mvp/verify-app.js && node mvp/verify-server.js && node desktop/verify-runtime.js && node desktop/verify-package.js",
    "build:win": "electron-builder --win nsis portable --x64",
    "build:win:dir": "electron-builder --win dir --x64",
    "prepare:mac-video-tools": "node scripts/bundle-mac-video-tools.mjs",
    "build:mac": "npm run prepare:mac-video-tools && electron-builder --mac dmg zip --arm64"
  },
  "build": {
    "appId": "com.warmseadog.ai-video-workbench",
    "productName": "AI 视频工作台",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "mvp/**/*",
      "package.json",
      "!mvp/local-config.js",
      "!mvp/local-config.json",
      "!outputs/**/*",
      "!**/*.log",
      "!**/.DS_Store"
    ],
    "mac": {
      "extraResources": [
        {
          "from": "resources/bin",
          "to": "bin",
          "filter": [
            "ffmpeg",
            "lib/**/*"
          ]
        }
      ]
    },
    "win": {
      "extraResources": [
        {
          "from": "resources/bin",
          "to": "bin",
          "filter": [
            "ffmpeg.exe"
          ]
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-windows-installer-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI 视频工作台"
    },
    "portable": {
      "artifactName": "${productName}-${version}-windows-portable-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3"
  }
}
